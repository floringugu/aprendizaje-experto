{
  // Tareas del arnés para el dueño (Ctrl+Shift+P → «Tasks: Run Task»).
  // Se ejecutan en un terminal de VS Code, fuera de Claude Code, como exigen «make fase» y «make abrir».
  // Las de worktree se lanzan desde la ventana del directorio principal (docs/plan.md §6).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arnés: fase de la próxima conversación",
      "detail": "Elige la fase y el área, y abre después una conversación nueva de Claude Code",
      "type": "shell",
      "command": "make fase F=${input:fase} A=${input:area}",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Arnés: abrir un worktree para una conversación",
      "detail": "Crea la rama y el directorio hermano con su fase y su área, y abre una ventana de VS Code",
      "type": "shell",
      "command": "make abrir N=${input:nombre} F=${input:fase} A=${input:area}",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Arnés: integrar un worktree en main",
      "detail": "Rebase sobre main, make check en el worktree y fusión sin commit de fusión",
      "type": "shell",
      "command": "make integrar N=${input:nombre}",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Arnés: retirar un worktree integrado",
      "detail": "Borra el worktree y la rama, solo si la rama ya está en main",
      "type": "shell",
      "command": "make retirar N=${input:nombre}",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "fase",
      "type": "pickString",
      "description": "Fase de la próxima conversación de Claude Code",
      "options": [
        { "label": "impl: etapa 4, implementar el área en curso (make check)", "value": "impl" },
        { "label": "specs: etapa 2, escribir features/ y parámetros (make check-specs)", "value": "specs" },
        { "label": "aceptacion: etapa 3, escribir los steps en rojo (make check-aceptacion)", "value": "aceptacion" }
      ],
      "default": "impl"
    },
    {
      "id": "area",
      "type": "promptString",
      "description": "Área en curso, por ejemplo MATE (vacío si ninguna; obligatoria en aceptacion)",
      "default": ""
    },
    {
      "id": "nombre",
      "type": "promptString",
      "description": "Nombre del worktree y de su rama (minúsculas y guiones), por ejemplo mate",
      "default": ""
    }
  ]
}
