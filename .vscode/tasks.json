{
  // Tareas del arnés para el dueño (Ctrl+Shift+P → «Tasks: Run Task»).
  // Se ejecutan en un terminal de VS Code, fuera de Claude Code, como exigen «make fase» y «make abrir».
  // Las de los carriles actúan sobre la carpeta principal, se lancen desde la ventana que sea (docs/plan.md §6).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arnés: fase de la próxima conversación",
      "detail": "Elige la fase y el área de la carpeta principal o de un carril, y abre después una conversación nueva de Claude Code",
      "type": "shell",
      "command": "make fase F=${input:fase} A=${input:area} N=${input:carril}",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Arnés: abrir un carril",
      "detail": "Crea el directorio hermano y su primera rama desde origin/main, con su fase y su área",
      "type": "shell",
      "command": "make abrir N=${input:nombre} F=${input:fase} A=${input:area}",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Arnés: abrir el carril de un ticket",
      "detail": "Crea el carril de docs/tickets/<nombre>.md, con la fase y el área del ticket; se niega si el ticket no está listo",
      "type": "shell",
      "command": "make abrir N=${input:nombre}",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Arnés: tablero de tickets",
      "detail": "Trae origin, escribe reports/tablero.html con el estado de los tickets y lo abre en el navegador",
      "type": "shell",
      "command": "make tablero",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Arnés: retirar un carril",
      "detail": "Borra el carril y todas sus ramas, solo si están fusionadas en origin/main y no queda relevo ni cambios",
      "type": "shell",
      "command": "make retirar N=${input:nombre}",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "fase",
      "type": "pickString",
      "description": "Fase de la próxima conversación de Claude Code",
      "options": [
        { "label": "impl: etapa 4, implementar el área en curso (make check)", "value": "impl" },
        { "label": "specs: etapa 2, escribir features/ y parámetros (make check-specs)", "value": "specs" },
        { "label": "aceptacion: etapa 3, escribir los steps en rojo (make check-aceptacion)", "value": "aceptacion" }
      ],
      "default": "impl"
    },
    {
      "id": "area",
      "type": "promptString",
      "description": "Área en curso, por ejemplo MATE (obligatoria en aceptacion y en los carriles; vacío si ninguna)",
      "default": ""
    },
    {
      "id": "nombre",
      "type": "promptString",
      "description": "Nombre del carril (minúsculas, números y guiones; cada tramo empieza por una letra), por ejemplo pasos",
      "default": ""
    },
    {
      "id": "carril",
      "type": "promptString",
      "description": "Carril, por ejemplo pasos (vacío: la carpeta principal)",
      "default": ""
    }
  ]
}
