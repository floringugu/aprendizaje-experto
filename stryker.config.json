{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.config.ts" },
  "mutate": [
    "src/dominio/**/*.ts",
    "src/aplicacion/**/*.ts",
    "!src/aplicacion/aplicacion.ts",
    "!src/aplicacion/contenido.ts",
    "!src/aplicacion/criterio-dominio.ts",
    "!src/aplicacion/csv.ts",
    "!src/aplicacion/diagnostico.ts",
    "!src/aplicacion/estado.ts",
    "!src/aplicacion/nivel-experto.ts",
    "!src/aplicacion/parametros.ts",
    "!src/aplicacion/practica.ts",
    "!src/aplicacion/presentacion.ts",
    "!src/aplicacion/progreso.ts",
    "!src/aplicacion/repasos.ts",
    "!src/aplicacion/respuestas.ts",
    "!src/aplicacion/sin-implementar.ts",
    "!src/aplicacion/texto-pdf.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutacion/index.html" },
  "thresholds": { "high": 80, "low": 60, "break": 95 },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "tempDirName": ".stryker-tmp"
}
