{
  "name": "aprendizaje-experto",
  "version": "0.0.0",
  "private": true,
  "description": "Framework de aprendizaje de novato a experto basado en docs/investigacion.md",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "tipos": "tsc --noEmit",
    "lint": "node scripts/arnes/lint.ts",
    "duplicacion": "jscpd .",
    "codigo-muerto": "knip",
    "capas": "depcruise --config .dependency-cruiser.cjs .",
    "unidad": "vitest run",
    "aceptacion": "cucumber-js",
    "cobertura-ids": "node scripts/arnes/cobertura-ids.ts",
    "integridad": "node scripts/arnes/integridad.ts",
    "specs": "node scripts/arnes/cobertura-ids.ts --solo-specs",
    "estado-aceptacion": "node scripts/arnes/estado-aceptacion.ts",
    "mutacion": "stryker run"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.5",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.13.0",
    "jscpd": "5.4.1",
    "knip": "6.42.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
